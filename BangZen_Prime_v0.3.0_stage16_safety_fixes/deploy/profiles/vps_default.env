# Profil default VPS (paper only). Dibaca oleh scripts/run_monitor_profile.sh.
# Nilai di sini harus sama dengan argumen di deploy/systemd/bangzen-prime-monitor.service.
BZ_INTERVAL_SECONDS=60
BZ_SCANS_PER_MINUTE=20
BZ_MAX_MINTS=100
BZ_WATCHLIST=watchlist.txt
# Penemuan koin terus-menerus (perintah discover): jeda antar siklus dan jumlah kandidat per siklus.
BZ_DISCOVER_INTERVAL_SECONDS=60
BZ_DISCOVER_LIMIT=30
