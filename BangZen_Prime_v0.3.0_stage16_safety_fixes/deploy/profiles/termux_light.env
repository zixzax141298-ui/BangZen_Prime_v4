# Profil ringan Termux (paper only): interval lebih panjang, scan lebih sedikit,
# watchlist lebih kecil. Angka ini adalah pilihan awal, BELUM DIUJI di perangkat.
BZ_INTERVAL_SECONDS=300
BZ_SCANS_PER_MINUTE=5
BZ_MAX_MINTS=25
BZ_WATCHLIST=watchlist.txt
# Penemuan lebih jarang dan kandidat lebih sedikit. BELUM DIUJI di perangkat.
BZ_DISCOVER_INTERVAL_SECONDS=600
BZ_DISCOVER_LIMIT=10
