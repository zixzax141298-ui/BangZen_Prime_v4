# Template unit untuk penemuan koin terus-menerus (perintah discover, paper only).
# Dirender oleh scripts/install_vps.sh. Placeholder: __APP_USER__, __APP_DIR__, __VENV_DIR__.
# Penemuan hanya memindai dan mengirim sinyal. Tidak ada order live dan tidak ada broadcast.
[Unit]
Description=BangZen Prime continuous token discovery (signal and paper only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
# Kill switch and env file use absolute paths, so the working directory cannot hide them.
Environment=BANGZEN_ENV_FILE=__APP_DIR__/.env
Environment=BANGZEN_HALT_FLAG_PATH=__APP_DIR__/HALT.flag
ExecStart=__VENV_DIR__/bin/bangzen-prime discover --interval-seconds 60 --limit 30
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=30
MemoryMax=512M
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__APP_DIR__
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
