#
#                              P R I M E
#
#   Copy this file to `.env` (gitignored). Every key MUST use BANGZEN_ prefix.
#   Unknown keys are rejected at startup (fail-closed).
#
#   Release posture: PAPER + SIGNAL ONLY. Live trading / broadcast stay locked
#   in code. Do not put seed phrases or private keys anywhere in this file.
#
# ═══════════════════════════════════════════════════════════════════════

# -----------------------------------------------------------------------------
# 1. SAFETY LOCKS
# -----------------------------------------------------------------------------
# Set true untuk mengizinkan eksekusi asli (Wajib disertai Private Key & Mode yang valid)
BANGZEN_LIVE_TRADING=false
BANGZEN_BROADCAST_ENABLED=false
BANGZEN_PAPER_TRADING=true
BANGZEN_DRY_RUN=true
BANGZEN_EMERGENCY_STOP=false
BANGZEN_MODE=paper

# Operating mode for execution orchestration:
# TELEGRAM_ONLY   = Hanya kirim sinyal ke Telegram (Tidak ada eksekusi)
# EXECUTION_ONLY  = Eksekusi beli/jual otomatis (Telegram mati)
# HYBRID          = Eksekusi beli/jual otomatis + Kirim notifikasi Telegram
BANGZEN_OPERATING_MODE=TELEGRAM_ONLY

# -----------------------------------------------------------------------------
# 2. RUNTIME / PERSISTENCE
# -----------------------------------------------------------------------------
BANGZEN_DB_PATH=bangzen.db
BANGZEN_LOG_LEVEL=INFO
BANGZEN_WATCHDOG_TIMEOUT_SECONDS=5
BANGZEN_HTTP_TIMEOUT_SECONDS=10
BANGZEN_HTTP_MAX_ATTEMPTS=3
BANGZEN_MARKET_DATA_MAX_AGE_SECONDS=120

# Optional lifecycle weapon policy JSON (leave empty for built-in default)
BANGZEN_POLICY_PATH=

# -----------------------------------------------------------------------------
# 3. MARKET / CHAIN PROVIDERS (optional - empty = adapter off / offline OK)
# -----------------------------------------------------------------------------
BANGZEN_DEXSCREENER_BASE_URL=https://api.dexscreener.com
BANGZEN_RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1

# Helius (RPC / history / Token-2022 evidence). Prefer API key only.
BANGZEN_HELIUS_API_KEY=
# Optional Yellowstone-style gRPC endpoint (must be https:// if set)
BANGZEN_GRPC_ENDPOINT=

BANGZEN_BIRDEYE_API_KEY=
BANGZEN_SOLANA_TRACKER_API_KEY=
BANGZEN_LUNARCRUSH_API_KEY=

# Jupiter quote / swap-v2 meta (quote and order only - signing not enabled)
BANGZEN_JUPITER_API_KEY=
BANGZEN_JUPITER_SLIPPAGE_BPS=50

# Cap for any tip budgeting in research paths (lamports)
BANGZEN_JITO_TIP_CAP_LAMPORTS=100000

# -----------------------------------------------------------------------------
# 4. TELEGRAM (signal-only gateway)
# -----------------------------------------------------------------------------
# Token and allowed chat IDs must be set together, or both left empty.
# Chat IDs: comma-separated ASCII numbers, e.g. 12345,-100987654
# -----------------------------------------------------------------------------
BANGZEN_TELEGRAM_BOT_TOKEN=
BANGZEN_TELEGRAM_ALLOWED_CHAT_IDS=

# -----------------------------------------------------------------------------
# 5. AI BRAIN (advisory only - cannot override risk / safety veto)
# -----------------------------------------------------------------------------
# Provider: anthropic | openai | grok
# -----------------------------------------------------------------------------
BANGZEN_AI_ENABLED=false
BANGZEN_AI_PROVIDER=anthropic
BANGZEN_AI_MODEL=
BANGZEN_AI_CONFIDENCE_THRESHOLD=0.6
BANGZEN_ANTHROPIC_API_KEY=
BANGZEN_OPENAI_API_KEY=
BANGZEN_GROK_API_KEY=

# -----------------------------------------------------------------------------
# 6. PAPER RISK / SIZING (simulation portfolio - not live capital)
# -----------------------------------------------------------------------------
BANGZEN_STARTING_EQUITY=1000
BANGZEN_MAX_RISK_PER_TRADE_PCT=1
BANGZEN_MAX_OPEN_POSITIONS=3
BANGZEN_MAX_EXPOSURE_QUOTE=500
BANGZEN_MAX_DRAWDOWN_PCT=20
BANGZEN_FEE_RATE=0.001
BANGZEN_SLIPPAGE_RATE=0.005

# Quality gates used when building signals
BANGZEN_MIN_LIQUIDITY_USD=10000
BANGZEN_MAX_RISK_SCORE=60

# -----------------------------------------------------------------------------
# 7. WATCH-ONLY WALLET IDENTITY (public address only)
# -----------------------------------------------------------------------------
# Valid Solana base58 address. Never a seed phrase or private key.
# Signer / fund access stay unavailable in this release.
# -----------------------------------------------------------------------------
BANGZEN_WALLET_PUBLIC_ADDRESS=

# -----------------------------------------------------------------------------
# 8. EXECUTION KEYS (Required for Live Trading & EXECUTION_ONLY/HYBRID modes)
# -----------------------------------------------------------------------------
# WARNING: Jangan pernah membagikan key ini. Jangan commit key asli ke Git.
# Gunakan Burner Wallet (dompet khusus dengan saldo kecil).
BANGZEN_BURNER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# NOT SUPPORTED (intentionally absent - do not add these keys)
# -----------------------------------------------------------------------------
# BANGZEN_OWNER_PRIVATE_KEY       - fatal if present in environment
# IS_LIVE_MODE / OWNER_MODE / PRODUCT_TIER - legacy names, unknown keys rejected
# VISION_AI_* / GROQ_* / OPENROUTER_* / EVOLUTION_AI_* - not in this build
# CABAL_HUNTER_* / TELEGRAM_TOKEN (unprefixed) - use BANGZEN_* names above

# Status: PAPER + SIGNAL-ONLY + FAIL-CLOSED
# -----------------------------------------------------------------------------
